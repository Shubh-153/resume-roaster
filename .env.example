# AI Provider Configuration
# Which AI provider to use: "anthropic" (default), "gemini", or "openrouter"
MODEL_PROVIDER=anthropic

# Anthropic (Claude) Configuration
ANTHROPIC_API_KEY=your_key_here
MODEL=claude-haiku-4-5

# Google Gemini Configuration
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-3.5-flash

# OpenRouter Configuration
# OpenRouter gives access to 100+ models through one API key
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_key_here
# Example models: anthropic/claude-3-haiku, openai/gpt-4o-mini,
#   google/gemini-2.0-flash-exp, meta-llama/llama-3-8b-instruct,
#   mistralai/mixtral-8x7b-instruct
OPENROUTER_MODEL=anthropic/claude-3-haiku

# Server Configuration
PORT=3000
